# Environment variables for MySivi Ad Intelligence & Creative Analysis System
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# Google Gemini API Key (Obtain free from https://aistudio.google.com/)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Configurable: gemini-3.8-flash, gemini-2.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-3.8-flash

# Apify API Token (Obtain free from https://console.apify.com/account/integrations)
APIFY_API_TOKEN=your_apify_api_token_here

# Apify Actor ID (Default: apify/facebook-ads-scraper)
APIFY_ACTOR_ID=apify/facebook-ads-scraper

# Facebook Ad Library Query Configuration
FB_SEARCH_KEYWORD=MySivi
FB_COUNTRY=IN
FB_MAX_ITEMS=10
FB_SEARCH_URL=https://www.facebook.com/ads/library/?active_status=active&ad_type=all&country=IN&is_targeted_country=false&media_type=all&q=%22MySivi%22&search_type=keyword_exact_phrase&sort_data[mode]=total_impressions&sort_data[direction]=desc

# Execution Mode: "live" (calls Apify + Gemini) or "mock" (uses validated fixtures for offline development & testing)
EXECUTION_MODE=mock

# Port Configuration
PORT_REPORT_SERVICE=5000
PORT_N8N=5678
